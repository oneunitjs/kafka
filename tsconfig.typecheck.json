{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "declaration": false,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "verbatimModuleSyntax": true
    },
    "include": ["test/types/**/*.ts", "src/**/*.ts"],
    "exclude": ["node_modules", "dist", "test/*.test.js"]
}
